# Copy to .env for local development. On Streamlit Community Cloud, put these in the app's Secrets instead.

# Optional. If set, every visitor uses this key (and your quota). Leave unset to make each visitor paste their own.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MAX_SOURCES_PER_SESSION=25
# MAX_CHUNKS_PER_SESSION=4000
